---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  { label: "Image to STL Converter", href: "/" },
  { label: "JPG to STL", href: "/jpg-to-stl/" },
  { label: "PNG to STL", href: "/png-to-stl/" },
  { label: "SVG to STL", href: "/svg-to-stl/" },
  { label: "Lithophane Maker", href: "/lithophane-maker/" },
  { label: "Text to STL", href: "/text-to-stl/" },
  { label: "Cookie Cutter", href: "/cookie-cutter/" },
  { label: "Heightmap Editor", href: "/heightmap-editor/" },
  { label: "How to Convert Image to STL", href: "/how-to-convert-image-to-stl/" },
  { label: "FAQ", href: "/faq/" },
  { label: "Blog", href: "/blog/" },
];
---

<BaseLayout
  title="Page Not Found (404) — Image to STL Converter"
  description="The page you are looking for does not exist. Explore free browser-based image to STL converters tools here — no uploads, no registration."
  canonical="https://www.image-2-stl.com/404/"
>
  <meta slot="head" name="robots" content="noindex" />
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-16 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-mono text-accent-600 dark:text-accent-400">Error 404</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-100">Page Not Found</h1>
      <p class="mt-4 text-surface-600 dark:text-surface-400 leading-relaxed">
        The page you are looking for has been moved or no longer exists.
        Use the links below to jump back to the free image to STL tools and guides.
      </p>
      <div class="mt-8 flex flex-wrap gap-2">
        {links.map((link) => (
          <a href={link.href} class="text-sm mb-1 px-3 py-1.5 rounded-lg bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
