---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConverterTool from "../components/ConverterTool";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Image to STL Converter",
  applicationCategory: "Multimedia",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online tool to convert images (JPG, PNG, SVG) to STL 3D models for 3D printing. Real-time 3D preview, browser-based processing. Supports heightmap, lithophane, and SVG extrusion modes.",
};

const websiteSchema = { "@context": "https://schema.org", "@type": "WebSite", name: "Image to STL Converter", url: "https://www.image-2-stl.com", description: "Free online tool to convert images to STL 3D models for 3D printing. Browser-based, no uploads required.", potentialAction: { "@type": "SearchAction", target: "https://www.image-2-stl.com/search?q={search_term_string}", "query-input": "required name=search_term_string" } }; const combinedSchema = [websiteSchema, softwareSchema];

const keywords = "image to stl, jpg to stl, png to stl, svg to stl, convert image to stl, image to 3d model, photo to stl, free stl converter, 3d printing, image to 3d print, online stl converter, heightmap to stl, lithophane maker, photo to 3d model";
---

<BaseLayout
  title="Image to STL Converter — Free Online 3D Model Generator"
  description="Convert JPG, PNG & SVG images to STL, OBJ, and GLB files for 3D printing. 100% browser-based, no uploads. Real-time 3D preview. Free, no registration."
  canonical="https://www.image-2-stl.com"
 schema={combinedSchema}
  breadcrumbs={[
    { name: "Image to STL Converter", url: "https://www.image-2-stl.com" }
  ]}
  keywords={keywords}
>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <section class="relative overflow-hidden rounded-3xl border border-surface-200/70 dark:border-surface-800/70 mb-10">
      <!-- 电影感背景大图 -->
      <img
        src="/images/hero-workspace.webp"
        alt=""
        aria-hidden="true"
        width="1792"
        height="1024"
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover opacity-30 dark:opacity-25"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-surface-50/85 dark:from-surface-950/85 via-surface-50/70 dark:via-surface-950/70 to-surface-50 dark:to-surface-950 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-surface-50/90 dark:from-surface-950/90 to-transparent pointer-events-none"></div>

      <div class="relative px-6 sm:px-10 py-16 sm:py-24 max-w-4xl">
        <p class="section-tag">Image-to-STL &mdash; Free Online Converter</p>
        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-[56px] font-bold tracking-tight text-surface-900 dark:text-surface-100 leading-[1.06]">
          Convert Image to STL Online &mdash;<br />
          <span class="text-gradient-accent">Free 3D Model Generator</span>
        </h1>
        <p class="mt-6 text-base sm:text-lg text-surface-600 dark:text-surface-400 leading-relaxed max-w-[58ch]">
          Transform your JPG, PNG, and SVG images into 3D-printable STL files &mdash; entirely in your browser.
          No uploads, no software downloads, no fees. Get instant real-time 3D preview powered by Three.js
          and download your model as STL, OBJ, or GLB in seconds.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#converter" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent-600 hover:bg-accent-700 text-white text-sm font-semibold shadow-lg shadow-accent-600/25 transition-all hover:-translate-y-0.5">
            Start Converting
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>
          <a href="#creations" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-surface-300 dark:border-surface-700 bg-surface-50/80 dark:bg-surface-900/60 text-surface-700 dark:text-surface-300 text-sm font-semibold hover:border-accent-400 hover:text-accent-600 dark:hover:text-accent-400 transition-all hover:-translate-y-0.5">
            See Examples
          </a>
        </div>
        <div class="mt-9 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-medium">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            100% Browser-Based &mdash; No Uploads
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-400 text-xs font-medium">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Export: STL + OBJ + GLB
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-200 dark:bg-surface-800 text-surface-600 dark:text-surface-400 text-xs font-medium">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
            No Registration Required
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs font-medium">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            Real-Time 3D Preview
          </span>
        </div>

        <!-- 滚动提示 -->
        <div class="mt-12 flex items-center gap-2 font-mono text-[11px] text-surface-400 dark:text-surface-500 uppercase tracking-[0.2em]">
          <span>Scroll to explore</span>
          <svg class="w-3.5 h-3.5 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </div>
      </div>
    </section>

    <!-- 01 — Converter -->
    <div id="converter" class="scroll-mt-28 reveal">
      <p class="section-tag">01 &mdash; The converter</p>
      <h2 class="editorial-title mt-2 mb-6">Turn any image into a <span class="text-gradient-accent">print-ready 3D model</span></h2>
      <ConverterTool client:only="react" />
    </div>

    <!-- 02 — At a glance -->
    <section class="mt-16 sm:mt-20 reveal">
      <p class="section-tag">02 &mdash; At a glance</p>
      <h2 class="editorial-title mt-2 mb-8">Built for speed, privacy &amp; scale</h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-4 text-center">
          <div class="text-xs text-surface-400 dark:text-surface-500 uppercase tracking-wide mb-1">Processing</div>
          <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">100% Browser-Based</div>
          <div class="text-2xs text-surface-500 mt-0.5">No server uploads ever</div>
        </div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-4 text-center">
          <div class="text-xs text-surface-400 dark:text-surface-500 uppercase tracking-wide mb-1">File Size Limit</div>
          <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">No Limits</div>
          <div class="text-2xs text-surface-500 mt-0.5">Constrained only by your device</div>
        </div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-4 text-center">
          <div class="text-xs text-surface-400 dark:text-surface-500 uppercase tracking-wide mb-1">Export Formats</div>
          <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">STL + OBJ + GLB</div>
          <div class="text-2xs text-surface-500 mt-0.5">Universal 3D printing + more</div>
        </div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-4 text-center">
          <div class="text-xs text-surface-400 dark:text-surface-500 uppercase tracking-wide mb-1">Cost</div>
          <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">Free Forever</div>
          <div class="text-2xs text-surface-500 mt-0.5">No hidden fees, no watermarks</div>
        </div>
      </div>
    </section>

    <section class="mt-16 sm:mt-20 border-t border-surface-200 dark:border-surface-800 pt-14 sm:pt-16 reveal">
      <p class="section-tag">03 &mdash; How it works</p>
      <h2 class="editorial-title mt-2 mb-8">Four steps to a finished model</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex flex-col gap-2">
          <span class="font-mono text-3xl sm:text-4xl font-semibold text-accent-500/90 dark:text-accent-400/90 tracking-tight">01</span>
          <h3 class="font-medium text-surface-900 dark:text-surface-100">Upload Your Image</h3>
          <p class="text-sm text-surface-500 leading-relaxed">Drag and drop a JPG, PNG, or SVG file &mdash; or try one of our built-in samples. All major image formats are supported. Your file stays on your device.</p>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-mono text-3xl sm:text-4xl font-semibold text-accent-500/90 dark:text-accent-400/90 tracking-tight">02</span>
          <h3 class="font-medium text-surface-900 dark:text-surface-100">Choose Mode &amp; Adjust</h3>
          <p class="text-sm text-surface-500 leading-relaxed">Select Heightmap for photo reliefs, SVG Extrude for logos, or Lithophane for backlit panels. Fine-tune height, smoothness, base thickness, and resolution with live sliders.</p>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-mono text-3xl sm:text-4xl font-semibold text-accent-500/90 dark:text-accent-400/90 tracking-tight">03</span>
          <h3 class="font-medium text-surface-900 dark:text-surface-100">Preview in Real-Time 3D</h3>
          <p class="text-sm text-surface-500 leading-relaxed">Rotate, zoom, and inspect your model interactively with Three.js. Toggle between solid and wireframe views. Every parameter change updates the preview instantly.</p>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-mono text-3xl sm:text-4xl font-semibold text-accent-500/90 dark:text-accent-400/90 tracking-tight">04</span>
          <h3 class="font-medium text-surface-900 dark:text-surface-100">Download &amp; Print</h3>
          <p class="text-sm text-surface-500 leading-relaxed">Export as STL for direct slicing in Cura, PrusaSlicer, or Bambu Studio. Also available in OBJ (with color) and GLB (for web/AR). Start printing immediately.</p>
        </div>
      </div>
    </section>

    <section class="mt-16 sm:mt-20 border-t border-surface-200 dark:border-surface-800 pt-14 sm:pt-16 reveal">
      <p class="section-tag">04 &mdash; Why this tool</p>
      <h2 class="editorial-title mt-2 mb-2">Why This Image to STL Converter</h2>
      <p class="text-sm text-surface-500 mb-8 max-w-[65ch]">Every feature is designed around one principle: your data stays on your device, and the result is print-ready in seconds.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-lg bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm">Private by Design</h3>
          </div>
          <p class="text-xs text-surface-500 leading-relaxed">Every conversion runs in your browser using JavaScript and Canvas APIs. No file ever leaves your device. No server-side processing. No data collection.</p>
        </div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-lg bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/><line x1="12" y1="22" x2="12" y2="15.5"/><polyline points="22 8.5 12 15.5 2 8.5"/></svg>
            </div>
            <h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm">Real-Time 3D Preview</h3>
          </div>
          <p class="text-xs text-surface-500 leading-relaxed">Powered by Three.js with WebGL hardware acceleration. Rotate, pan, and zoom your model before downloading. Switch between solid and wireframe views to inspect mesh quality.</p>
        </div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-lg bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            </div>
            <h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm">Three Conversion Modes</h3>
          </div>
          <p class="text-xs text-surface-500 leading-relaxed">Heightmap converts pixel brightness to physical height &mdash; ideal for portraits and reliefs. SVG Extrusion extracts vector paths into crisp 3D solids. Lithophane mode creates translucent backlit panels.</p>
        </div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-lg bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm">Three Export Formats</h3>
          </div>
          <p class="text-xs text-surface-500 leading-relaxed">Download as binary STL &mdash; the universal 3D printing format. Or choose OBJ for color support in Blender. GLB (glTF binary) for modern web, AR, and VR applications.</p>
        </div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-lg bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm">No Limits, No Waiting</h3>
          </div>
          <p class="text-xs text-surface-500 leading-relaxed">Everything runs locally &mdash; no queue, no cooldown, no daily cap. Convert as many images as you want. File size limited only by your device memory. No account needed.</p>
        </div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-lg bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm">SVG &amp; Vector Support</h3>
          </div>
          <p class="text-xs text-surface-500 leading-relaxed">A unique feature competitors do not offer. Upload SVG logos, icons, and vector art &mdash; our parser extracts real bezier paths and extrudes them into solid, watertight 3D meshes. Perfect for signage and badges.</p>
        </div>
      </div>
    </section>

    <section class="mt-16 sm:mt-20 border-t border-surface-200 dark:border-surface-800 pt-14 sm:pt-16 reveal">
      <p class="section-tag">05 &mdash; Formats</p>
      <h2 class="editorial-title mt-2 mb-2">Supported File Formats</h2>
      <p class="text-sm text-surface-500 mb-8 max-w-[65ch]">Upload images in any common format and export your 3D model in the format that fits your workflow.</p>
      <div class="grid sm:grid-cols-2 gap-8">
        <div>
          <h3 class="text-sm font-semibold text-surface-700 dark:text-surface-300 mb-4 uppercase tracking-wide">Input &mdash; Image Formats</h3>
          <div class="flex flex-wrap gap-2">
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-100 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700"><span class="text-xs font-mono font-medium text-surface-900 dark:text-surface-100">JPG / JPEG</span><span class="text-2xs text-surface-400 hidden sm:inline">Photographs</span></div>
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-100 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700"><span class="text-xs font-mono font-medium text-surface-900 dark:text-surface-100">PNG</span><span class="text-2xs text-surface-400 hidden sm:inline">Transparency-aware</span></div>
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-100 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700"><span class="text-xs font-mono font-medium text-surface-900 dark:text-surface-100">SVG</span><span class="text-2xs text-surface-400 hidden sm:inline">Vector extrusion</span></div>
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-100 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700"><span class="text-xs font-mono font-medium text-surface-900 dark:text-surface-100">WebP</span><span class="text-2xs text-surface-400 hidden sm:inline">Modern web images</span></div>
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-100 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700"><span class="text-xs font-mono font-medium text-surface-900 dark:text-surface-100">BMP</span><span class="text-2xs text-surface-400 hidden sm:inline">Uncompressed</span></div>
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-100 dark:bg-surface-800/50 border border-surface-200 dark:border-surface-700"><span class="text-xs font-mono font-medium text-surface-900 dark:text-surface-100">GIF</span><span class="text-2xs text-surface-400 hidden sm:inline">Single-frame</span></div>
          </div>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-surface-700 dark:text-surface-300 mb-4 uppercase tracking-wide">Output &mdash; 3D Formats</h3>
          <div class="flex flex-wrap gap-2">
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-accent-50 dark:bg-accent-900/20 border border-accent-200 dark:border-accent-800"><span class="text-xs font-mono font-semibold text-accent-700 dark:text-accent-400">STL</span><span class="text-2xs text-accent-500 dark:text-accent-500 hidden sm:inline">Universal 3D printing</span></div>
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-accent-50 dark:bg-accent-900/20 border border-accent-200 dark:border-accent-800"><span class="text-xs font-mono font-semibold text-accent-700 dark:text-accent-400">OBJ</span><span class="text-2xs text-accent-500 dark:text-accent-500 hidden sm:inline">Color support (Blender)</span></div>
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-accent-50 dark:bg-accent-900/20 border border-accent-200 dark:border-accent-800"><span class="text-xs font-mono font-semibold text-accent-700 dark:text-accent-400">GLB</span><span class="text-2xs text-accent-500 dark:text-accent-500 hidden sm:inline">Web, AR &amp; VR ready</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="creations" class="mt-16 sm:mt-20 border-t border-surface-200 dark:border-surface-800 pt-14 sm:pt-16 scroll-mt-28 reveal">
      <p class="section-tag">06 &mdash; Creations</p>
      <h2 class="editorial-title mt-2 mb-2">What You Can Create</h2>
      <p class="text-sm text-surface-500 mb-8 max-w-[65ch]">From wall art to custom tools, here is what makers create with this image to STL converter.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 overflow-hidden work-card group"><img src="/images/photo-relief-print.webp" alt="3D printed photo relief — white PLA bas-relief portrait on display stand" width="1024" height="1024" loading="lazy" decoding="async" class="w-full aspect-square object-cover work-img" /><div class="p-5"><h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm mb-2">3D Photo Reliefs</h3><p class="text-xs text-surface-500 leading-relaxed">Turn any portrait, landscape, or artwork into an embossed 3D panel. The heightmap mode maps pixel brightness to physical depth, creating detailed reliefs perfect for wall art, coasters, and decorative tiles.</p></div></div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 overflow-hidden work-card group"><img src="/images/lithophane-backlit.webp" alt="3D printed lithophane panel glowing with warm backlight showing a landscape scene" width="1024" height="1024" loading="lazy" decoding="async" class="w-full aspect-square object-cover work-img" /><div class="p-5"><h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm mb-2">Lithophanes</h3><p class="text-xs text-surface-500 leading-relaxed">Convert your photos into thin translucent panels. When backlit, the varying thickness reveals your image in stunning detail. Makes incredible personalized lamps, night lights, and window displays.</p></div></div>
        <div class="rounded-tool border border-surface-200 dark:border-surface-800 overflow-hidden work-card group"><img src="/images/cookie-cutter-result.webp" alt="Custom 3D printed cookie cutters in bright colors alongside freshly cut cookies" width="1024" height="1024" loading="lazy" decoding="async" class="w-full aspect-square object-cover work-img" /><div class="p-5"><h3 class="font-semibold text-surface-900 dark:text-surface-100 text-sm mb-2">Cookie Cutters</h3><p class="text-xs text-surface-500 leading-relaxed">Upload a silhouette or simple shape and get a custom cookie cutter STL. Perfect for themed parties, holidays, and personalized gifts.</p></div></div>
