---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "JPG to STL", href: "/jpg-to-stl/" },
  { label: "PNG to STL", href: "/png-to-stl/" },
  { label: "SVG to STL", href: "/svg-to-stl/" },
  { label: "Lithophane", href: "/lithophane-maker/" },
  { label: "Text to STL", href: "/text-to-stl/" },
  { label: "Cookie Cutter", href: "/cookie-cutter/" },
];
---

<header class="sticky top-0 z-50 border-b border-surface-200/80 dark:border-surface-800/80 bg-surface-50/80 dark:bg-surface-950/80 backdrop-blur-md">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <a
      href="/"
      class="flex items-center gap-2 font-semibold text-surface-900 dark:text-surface-100 tracking-tight hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
    >
      <svg class="w-6 h-6 text-accent-600 dark:text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
        <line x1="12" y1="22.08" x2="12" y2="12" />
      </svg>
      <span class="hidden sm:inline">Image to STL</span>
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Main">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
            currentPath === item.href
              ? "bg-surface-200 dark:bg-surface-800 text-surface-900 dark:text-surface-100"
              : "text-surface-600 dark:text-surface-400 hover:text-surface-900 dark:hover:text-surface-100"
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden md:flex items-center gap-2">
        <a href="/heightmap-editor/" class="text-sm text-surface-500 hover:text-surface-700 dark:hover:text-surface-300 transition-colors">Editor</a>
        <a href="/how-to-convert-image-to-stl/" class="text-sm text-surface-500 hover:text-surface-700 dark:hover:text-surface-300 transition-colors">Guide</a>
        <a href="/faq/" class="text-sm text-surface-500 hover:text-surface-700 dark:hover:text-surface-300 transition-colors">FAQ</a>
        <a href="/blog/" class="text-sm text-surface-500 hover:text-surface-700 dark:hover:text-surface-300 transition-colors">Blog</a>
      </div>
      <button
        type="button"
        class="md:hidden p-1.5 rounded-lg text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800"
        aria-label="Menu"
        id="mobile-menu-btn"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="md:hidden hidden border-t border-surface-200 dark:border-surface-800 py-2 px-4 bg-surface-50/95 dark:bg-surface-950/95 backdrop-blur-md">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      <a href="/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">Image to STL</a>
      <a href="/jpg-to-stl/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">JPG to STL</a>
      <a href="/png-to-stl/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">PNG to STL</a>
      <a href="/svg-to-stl/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">SVG to STL</a>
      <a href="/lithophane-maker/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">Lithophane Maker</a>
      <a href="/text-to-stl/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">Text to STL</a>
      <a href="/cookie-cutter/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">Cookie Cutter</a>
      <a href="/photo-to-3d/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">Photo to 3D</a>
      <a href="/heightmap-editor/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">Heightmap Editor</a>
      <a href="/how-to-convert-image-to-stl/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">Guide</a>
      <a href="/faq/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">FAQ</a>
      <a href="/blog/" class="px-3 py-2 rounded-lg text-sm text-surface-600 dark:text-surface-400 hover:bg-surface-200 dark:hover:bg-surface-800 hover:text-surface-900 dark:hover:text-surface-100">Blog</a>
    </nav>
  </div>
</header>
<script>
  document.getElementById("mobile-menu-btn")?.addEventListener("click", () => {
    document.getElementById("mobile-nav")?.classList.toggle("hidden");
  });
</script>
