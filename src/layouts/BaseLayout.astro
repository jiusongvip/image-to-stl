---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";

 export interface Props {
   title: string;
   description: string;
   canonical?: string;
   schema?: object;
   keywords?: string;
   ogImage?: string;
   ogType?: string;
   breadcrumbs?: { name: string; url: string }[];
   publishDate?: string;
   modifyDate?: string;
 }

 const { title, description, canonical, schema, keywords, ogImage, ogType, breadcrumbs, publishDate, modifyDate } = Astro.props;

 const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
   "@context": "https://schema.org",
   "@type": "BreadcrumbList",
   "itemListElement": breadcrumbs.map((item, i) => ({
     "@type": "ListItem",
     "position": i + 1,
     "name": item.name,
     "item": item.url
   }))
 } : null;

 const combinedSchema = schema
   ? [schema, breadcrumbSchema].filter(Boolean)
   : breadcrumbSchema ? [breadcrumbSchema] : undefined;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <!-- charset must appear within the first 1024 bytes, so it stays ahead of
         everything else — including the preloads below. -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Emitted next so the LCP image and the above-the-fold fonts are
         discovered as early as possible. -->
    <slot name="head-preload" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Geist-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Geist-SemiBold.woff2"
      crossorigin
    />
    <script is:inline>
      // Enables JS-only enhancements (e.g. the .reveal scroll animation) without
      // risking content being stuck invisible when JS never runs.
      document.documentElement.classList.add('js');
    </script>
    <!-- Google tag (gtag.js) — deferred so it never competes with the LCP resource.

         Two separate concerns, deliberately handled differently:

         1. The `dataLayer` stub is installed immediately (at the TOP of <head>),
            so any event fired by page code before the library arrives is still
            queued and replayed. This is just an array push — effectively free,
            and it must exist before any other script can call gtag().
         2. The 168 KB library is NOT fetched at a fixed early moment. Measurement
            showed a plain `requestIdleCallback({timeout: 3000})` firing at ~728 ms
            on a fast desktop — exactly during the LCP window — and then blocking
            the main thread for 207 ms + 129 ms.

         So it is gated on the page actually being *finished and quiet*:
         load + idle, or first user interaction, whichever comes first. Losing a
         few seconds of the very first session's analytics is the right trade for
         removing ~336 ms of blocking time from the critical path. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <SeoHead title={title} description={description} canonical={canonical} schema={combinedSchema} keywords={keywords} ogImage={ogImage} ogType={ogType} publishDate={publishDate} modifyDate={modifyDate} />
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-[100dvh]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <!-- gtag config + library load, at the very end of <body> so it sits behind
         all real content in the parse queue. See the stub in <head> above. -->
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-855ZSKSVHZ');
      (function () {
        var loaded = false;
        function loadGtag() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-855ZSKSVHZ';
          document.head.appendChild(s);
        }
        var armed = false;
        function arm() {
          if (armed) return;
          armed = true;
          // Wait for the page to be genuinely quiet, then yield one more slice
          // so the browser can paint before we hand it 168 KB of JS.
          ['pointerdown', 'keydown', 'touchstart', 'wheel'].forEach(function (e) {
            window.removeEventListener(e, arm);
          });
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadGtag, { timeout: 2000 });
          } else {
            setTimeout(loadGtag, 1200);
          }
        }
        ['pointerdown', 'keydown', 'touchstart', 'wheel'].forEach(function (e) {
          window.addEventListener(e, arm, { once: true, passive: true });
        });
        if (document.readyState === 'complete') arm();
        else window.addEventListener('load', arm, { once: true });
      })();
    </script>
  </body>
</html>
