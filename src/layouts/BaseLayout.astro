---
/*
  HEAD ORDERING RULES — read before editing the head element.

  Everything in the head is ordered by byte position, because the browser cannot
  discover (let alone fetch) a subresource until it has parsed the bytes that
  precede it. On the throttled mobile profile this document is ~21 KB over a
  ~95 KB/s link, so every hundred bytes spent before the stylesheet link is a
  hundred bytes of added render-blocking time.

  Concretely:
    - charset first (must land within the first 1024 bytes, or the browser has
      to re-parse the document).
    - preloads before anything deferrable.
    - Astro hoists the compiled stylesheet link, the module script and the
      JSON-LD schema to the FRONT of the head, ahead of everything written here.
      scripts/inject-css-preload.mjs therefore runs post-build to inject a
      stylesheet preload and to move the schema back to the end of the head.

  DO NOT PUT COMMENTS INSIDE THE HEAD ELEMENT. Astro strips these comment blocks
  in component bodies but NOT as direct children of a head in a .astro layout —
  they are emitted verbatim into the HTML. A 1067-byte explanatory comment used
  to be served to every visitor on every request, and any comment containing a
  closing-head token silently ended the head early, pushing the metas and
  preloads outside it. scripts/inject-css-preload.mjs fails the build if the
  charset offset ever exceeds 1024, which is how this was caught.

  Also do not write brace-star comment syntax in this frontmatter: it is parsed
  as JavaScript, where that construct is a syntax error, not a comment.

  FONT PRELOADS — preload every weight the above-the-fold content renders, and
  nothing else. The list was originally Regular + SemiBold only, but the hero
  renders Bold for the h1, Medium for the author link and the four feature
  badges, and GeistMono for the "01 02 03 04" step labels. Those faces were
  therefore fetched late (starting around 270ms, after first paint) and their
  arrival changed text metrics and reflowed the hero, which Lighthouse
  attributed to "Web font loaded": 0.072 CLS on mobile, and 0.41 on desktop
  where the hero section is 713px tall and overflows the 720px viewport, so
  the mono step labels are above the fold there even though they are below it
  on a phone. A face that is rendered above the fold but not preloaded is
  strictly worse than preloading it: the request happens anyway, just too late
  to avoid the shift.

  Do not reason about "above the fold" from source order alone — measure the
  element rects at both 390x844 and 1280x720. The mono block looked below the
  fold in the markup but is inside the desktop viewport.
*/
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";

 export interface Props {
   title: string;
   description: string;
   canonical?: string | null;
   schema?: object;
   keywords?: string;
   ogImage?: string;
   ogType?: string;
   breadcrumbs?: { name: string; url: string }[];
   publishDate?: string;
   modifyDate?: string;
 }

 const { title, description, canonical, schema, keywords, ogImage, ogType, breadcrumbs, publishDate, modifyDate } = Astro.props;

 // Breadcrumb item URLs must be the canonical form, i.e. with a trailing slash
 // (see astro.config.mjs: site + trailingSlash:"always"). A slash-less URL is a
 // 308 redirect, so declaring one here makes the structured data point at a
 // redirecting URL -- Google crawls it, follows the hop, and files the source
 // under "Page with redirect" in Search Console. Normalising in this one place
 // means a new page cannot reintroduce it by forgetting the slash. The bare
 // origin is deliberately left alone: that is the homepage's canonical form,
 // and it is what the sitemap and <link rel="canonical"> use.
 const toCanonicalUrl = (raw: string) => {
   const m = raw.match(/^(https?:\/\/[^/?#]+)([^?#]*)([?#].*)?$/);
   if (!m) return raw;
   const [, origin, path, suffix = ""] = m;
   const p = path === "" || path === "/" ? "" : path.endsWith("/") ? path : `${path}/`;
   return `${origin}${p}${suffix}`;
 };

 const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
   "@context": "https://schema.org",
   "@type": "BreadcrumbList",
   "itemListElement": breadcrumbs.map((item, i) => ({
     "@type": "ListItem",
     "position": i + 1,
     "name": item.name,
     "item": toCanonicalUrl(item.url)
   }))
 } : null;

 const combinedSchema = schema
   ? [schema, breadcrumbSchema].filter(Boolean)
   : breadcrumbSchema ? [breadcrumbSchema] : undefined;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head-preload" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Geist-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Geist-Medium.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Geist-SemiBold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Geist-Bold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/GeistMono-Regular.woff2"
      crossorigin
    />
    <script is:inline>
      // Enables JS-only enhancements (e.g. the .reveal scroll animation) without
      // risking content being stuck invisible when JS never runs.
      document.documentElement.classList.add('js');
    </script>
    <link
      rel="stylesheet"
      href="/fonts/deferred.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href="/fonts/deferred.css" /></noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <SeoHead title={title} description={description} canonical={canonical} schema={combinedSchema} keywords={keywords} ogImage={ogImage} ogType={ogType} publishDate={publishDate} modifyDate={modifyDate} />
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-[100dvh]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {/*
      Google tag (gtag.js) — deferred so it never competes with the LCP resource.

      Two separate concerns, deliberately handled differently:

      1. The `dataLayer` stub below is a plain array push — effectively free. It
         only has to run before the first gtag() CALL, and every call site lives
         in this same script, so it belongs here at the end of <body> rather than
         inline in <head>, where it used to occupy ~1.3 KB of the critical byte
         range ahead of the stylesheet. Any page-level event fired earlier still
         queues correctly as long as it uses dataLayer.push().
      2. The 168 KB library is NOT fetched at a fixed early moment. Measurement
         showed a plain `requestIdleCallback({timeout: 3000})` firing at ~728 ms
         on a fast desktop — exactly during the LCP window — and then blocking
         the main thread for 207 ms + 129 ms.

      INTERACTION-ONLY. An earlier revision also fired on `load` (via
      requestIdleCallback with a 2 s timeout). That still put the download and
      its parse/execute inside the mobile LCP window, because `load` arrives
      well before the page is idle on a throttled phone. There is no safe
      automatic moment: the LCP window is exactly when we must not hand the main
      thread 168 KB of JavaScript. So the fetch is now triggered ONLY by a real
      user signal — pointerdown / keydown / touchstart / wheel — and by nothing
      else. A session with zero interaction sends zero analytics; that is the
      accepted trade. Note this is deliberate behaviour, not a bug: if analytics
      volume ever looks low, check interaction rates before debugging the tag.
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-855ZSKSVHZ');
      (function () {
        var loaded = false;
        function loadGtag() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-855ZSKSVHZ';
          document.head.appendChild(s);
        }
        // Purely an event registration — no timer, no `load` hook. The stub
        // above already recorded `js` and `config`, so the first event that
        // arrives after this point still carries the right client id.
        ['pointerdown', 'keydown', 'touchstart', 'wheel'].forEach(function (e) {
          window.addEventListener(e, loadGtag, { once: true, passive: true });
        });
      })();
    </script>
  </body>
</html>
