---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";

 export interface Props {
   title: string;
   description: string;
   canonical?: string;
   schema?: object;
   keywords?: string;
   ogImage?: string;
   ogType?: string;
   breadcrumbs?: { name: string; url: string }[];
   publishDate?: string;
   modifyDate?: string;
 }

 const { title, description, canonical, schema, keywords, ogImage, ogType, breadcrumbs, publishDate, modifyDate } = Astro.props;

 const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
   "@context": "https://schema.org",
   "@type": "BreadcrumbList",
   "itemListElement": breadcrumbs.map((item, i) => ({
     "@type": "ListItem",
     "position": i + 1,
     "name": item.name,
     "item": item.url
   }))
 } : null;

 const combinedSchema = schema
   ? [schema, breadcrumbSchema].filter(Boolean)
   : breadcrumbSchema ? [breadcrumbSchema] : undefined;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <script is:inline>
      // Enables JS-only enhancements (e.g. the .reveal scroll animation) without
      // risking content being stuck invisible when JS never runs.
      document.documentElement.classList.add('js');
    </script>
    <!-- Google tag (gtag.js) — deferred so it never competes with the LCP resource.
         The stub queue is installed immediately, so no events are lost; the
         library itself is only fetched once the main thread is idle. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-855ZSKSVHZ');
      (function () {
        var loaded = false;
        function loadGtag() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-855ZSKSVHZ';
          document.head.appendChild(s);
        }
        // Load after the first paint is free of contention.
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGtag, { timeout: 3000 });
        } else {
          setTimeout(loadGtag, 1800);
        }
        // Fallback: never leave a real user without analytics.
        window.addEventListener('load', function () {
          setTimeout(loadGtag, 1200);
        }, { once: true });
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <SeoHead title={title} description={description} canonical={canonical} schema={combinedSchema} keywords={keywords} ogImage={ogImage} ogType={ogType} publishDate={publishDate} modifyDate={modifyDate} />
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-[100dvh]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
